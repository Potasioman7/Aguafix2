# App
PORT=3000

# Database
# Local:
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=TaYa0407
DB_NAME=water_leaks_db
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Ejemplo para AWS RDS / Aurora PostgreSQL:
# DB_HOST=water-leaks-db.xxxxxxxxxx.us-east-1.rds.amazonaws.com
# DB_PORT=5432
# DB_USERNAME=admin_municipio
# DB_PASSWORD=************
# DB_NAME=water_leaks_db
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=tu_correo@gmail.com
MAIL_PASSWORD=tu_password_o_app_password
MAIL_FROM="Municipio - Fugas de Agua" <no-reply@municipio.gob>

# Correo de la cuadrilla de mantenimiento que recibe los avisos
MAINTENANCE_CREW_EMAIL=cuadrilla@municipio.gob

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# AWS S3 (fotos de los reportes)
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=aguafix-reportes
# Opcionales: solo si NO vas a usar un IAM Role (EC2/ECS) y necesitas
# credenciales explicitas (por ejemplo en local o en el .env de produccion).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Opcional: dominio publico alterno (ej. CloudFront) en vez de la URL
# directa de S3 (https://<bucket>.s3.<region>.amazonaws.com)
AWS_S3_PUBLIC_BASE_URL=
